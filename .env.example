# Required for real LLM chat: OpenRouter API key
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data
# If not set, the built-in market simulator is used
MASSIVE_API_KEY=

# Optional: Massive poll interval in seconds (default 15 = free tier)
MASSIVE_POLL_INTERVAL=15

# Optional: "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false
